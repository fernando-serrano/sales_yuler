# ===================================================================
# Variables de entorno para la aplicacion de consolidacion de ventas
# ===================================================================

GOOGLE_SERVICE_ACCOUNT_JSON=
# Ruta del archivo JSON de la cuenta de servicio en el directorio /secrets
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/ventas-joyas-bot-9999999999.json
# Hoja de calculo de destino donde se consolidaran los datos de ventas
TARGET_SPREADSHEET_ID=1AMGRZ9vdJPXTHCvPLdu9Q954CkWU2tdsZ6VicGmGAbo
TARGET_WORKSHEET_NAME=ventas_consolidado
# Archivo YAML que define las fuentes de datos
SOURCES_CONFIG=config/sources.yml
# Ventana deslizante para lectura incremental
PIPELINE_LOOKBACK_DAYS=3
# Fecha opcional para corridas controladas: YYYY-MM-DD
PIPELINE_RUN_DATE=
